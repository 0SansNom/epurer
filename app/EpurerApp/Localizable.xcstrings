    "Épurer ne peut pas modifier %@ : %lld chemins hors de portée.": {
      "comment": "Protected Paths note. The count only picks singular or plural.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Épurer can’t change %1$@: %#@n@"
          },
          "substitutions": {
            "n": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "this path is out of reach. No need to protect it."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "these paths are out of reach. No need to protect them."
                    }
                  }
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épurer ne peut pas modifier %1$@ : %#@n@"
          },
          "substitutions": {
            "n": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "ce chemin est hors de portée. Inutile de le protéger."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "ces chemins sont hors de portée. Inutile de les protéger."
                    }
                  }
                }
              }
            }
          }
        }
